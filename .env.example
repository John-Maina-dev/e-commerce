SECRET_KEY=change-me
# SECRET_KEY is REQUIRED when DEBUG=False — the app will refuse to start without
# a real random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`).
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Database (defaults to SQLite when DB_ENGINE is blank)
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# SMTP used for account emails when the in-app SMTP settings are not configured
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=

# Production hardening
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# NOTE: M-Pesa Daraja and per-store SMTP credentials are configured at runtime
# via the manage UI (Manage → Settings) and stored in the database, not here.
#
# OPTIONAL: You may also set Daraja credentials as environment variables.
# When set, env vars take precedence over database values. This is useful
# for Docker / systemd deployments where secrets are injected at runtime.
# NEVER commit real secrets to source control.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_ENVIRONMENT=sandbox
