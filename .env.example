# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
# SECRET_KEY is REQUIRED when DEBUG=False — the app will refuse to start without
# a real random value (e.g. `python -c "import secrets; print(secrets.token_urlsafe(50))"`).
SECRET_KEY=dev-only-change-me-to-a-secure-random-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.ngrok-free.app,.ngrok.io
CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok.io

# ------------------------------------------------------------------------------
# Database (defaults to SQLite when DB_ENGINE is blank)
# ------------------------------------------------------------------------------
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# ------------------------------------------------------------------------------
# Safaricom Daraja M-Pesa Settings
# NOTE: M-Pesa credentials can also be configured at runtime in Manage -> Settings
# Environment variables take precedence over in-app settings (supports DARAJA_* aliases).
# ------------------------------------------------------------------------------
# Environment: 'sandbox' or 'production'
MPESA_ENV=sandbox

# Account Type: 'paybill' or 'till'
MPESA_ACCOUNT_TYPE=paybill

# Business Shortcode (Default sandbox PayBill is 174379)
MPESA_SHORTCODE=174379

# Passkey (Default sandbox passkey for shortcode 174379)
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Daraja Developer Portal App Credentials (Consumer Key & Consumer Secret)
# Ensure the app created on developer.safaricom.co.ke has "Lipa na M-Pesa Sandbox" enabled
MPESA_CONSUMER_KEY=your_daraja_consumer_key_here
MPESA_CONSUMER_SECRET=your_daraja_consumer_secret_here

# Ngrok Public HTTPS Base URL (no trailing slash)
# Example: https://a1b2-c3d4.ngrok-free.app
MPESA_CALLBACK_BASE_URL=https://your-ngrok-domain.ngrok-free.app

# Direct Callback URL (optional override)
MPESA_CALLBACK_URL=

# ------------------------------------------------------------------------------
# Email / SMTP Settings
# Used for account and notification emails when in-app SMTP settings are blank.
# ------------------------------------------------------------------------------
# For Gmail, generate an App Password via Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=Reeves Boutique <your-email@gmail.com>

# ------------------------------------------------------------------------------
# Production Hardening (Enabled when DEBUG=False)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
